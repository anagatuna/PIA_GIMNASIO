@page
@model PIA_Gimnasio.Pages.MembresiaModel
@{
    ViewData["Title"] = "Tipos de membresía";
    ViewData["AnchoCompleto"] = true;
    ViewData["EliminarTitulo"] = "¿Eliminar membresía?";
    ViewData["EliminarDescripcion"] = "ya no se podrá vender. No se puede eliminar si hay socios con esta membresía activa.";
    bool esEdicion = Model.Membresia.IdTipoMembresia > 0;

    // Color de la etiqueta según el plan
    string ClasePlan(string nombre) => nombre.ToUpper() switch
    {
        "ORO" => "etiqueta-oro",
        "PLATA" => "etiqueta-plata",
        "BRONCE" => "etiqueta-bronce",
        _ => "etiqueta-rol"
    };
}

<section class="gestion">
    <div class="row g-4">

        <!-- Gestión de información -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center">
                    <i class="bi bi-tags"></i>&nbsp;@(esEdicion ? "Editar membresía" : "Nueva membresía")
                </h4>

                <form method="post" asp-page-handler="Guardar" asp-all-route-data="Model.RutaFiltros()">
                    <input type="hidden" asp-for="Membresia.IdTipoMembresia" />

                    <h6 class="subtitulo-seccion">Plan</h6>
                    <div class="form-floating mb-3">
                        <input asp-for="Membresia.Nombre" class="form-control" placeholder="Nombre" maxlength="50" autocomplete="off" required />
                        <label asp-for="Membresia.Nombre">Nombre<span class="asterisco"> *</span></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Membresia.Descripcion" class="form-control" placeholder="Descripción" maxlength="50" autocomplete="off" required />
                        <label asp-for="Membresia.Descripcion">Descripción<span class="asterisco"> *</span></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Membresia.Precio" type="number" step="0.01" min="0.01" class="form-control" placeholder="Precio" required />
                        <label asp-for="Membresia.Precio">Precio mensual ($)<span class="asterisco"> *</span></label>
                    </div>

                    <hr />

                    <h6 class="subtitulo-seccion">Restricciones</h6>
                    <div class="form-floating mb-1">
                        <input asp-for="Membresia.MaxClasesSemana" type="number" min="0" max="7" class="form-control" placeholder="Clases" required />
                        <label asp-for="Membresia.MaxClasesSemana">Clases grupales por semana<span class="asterisco"> *</span></label>
                    </div>
                    <small class="ayuda">Límite exacto que se valida al capturar reservas. 0 = sin clases grupales.</small>

                    <div class="row">
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Membresia.RestriccionAforo" asp-items="Model.Restricciones" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Membresia.RestriccionAforo">Aforo<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Membresia.IdEstatus" asp-items="Model.Estatus" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Membresia.IdEstatus">Estatus<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <div class="nota">
                        <strong>Nota:</strong> Los campos obligatorios están marcados con
                        <abbr title="obligatorio" class="asterisco">*</abbr>.
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="submit" class="btn btn-naranja">
                            <i class="bi bi-floppy me-1"></i>@(esEdicion ? "Actualizar" : "Guardar")
                        </button>
                        <a class="btn btn-oscuro" asp-page="/Membresia" asp-all-route-data="Model.RutaFiltros()">Cancelar</a>
                    </div>
                </form>

                <hr />
                <h5 class="titulo-card text-center"><i class="bi bi-info-circle-fill"></i>&nbsp;Información</h5>
                <div class="info">
                    Oferta comercial del gimnasio. Cada suscripción dura <b>1 mes</b>.
                    El límite semanal de clases dicta cuántas reservas puede tener un socio por semana:
                    <b>Bronce 0</b>, <b>Plata 3</b> y <b>Oro 5</b>.
                </div>
            </div>
        </div>

        <!-- Consulta de registros -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                <h4 class="titulo-card"><i class="bi bi-grid-3x3-gap"></i>&nbsp;Consulta registros: <span class="resaltado">Membresías</span></h4>

                <p class="mb-2"><strong><i class="bi bi-funnel"></i>&nbsp;Área de búsqueda</strong></p>
                <form method="get">
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <div class="form-floating">
                                <input asp-for="BusquedaNombre" class="form-control" placeholder="Búsqueda por nombre" maxlength="50" />
                                <label asp-for="BusquedaNombre">Búsqueda por nombre</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdEstatus" asp-items="Model.Estatus" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdEstatus">Estatus</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4 d-flex align-items-center">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn-circulo btn-naranja" title="Buscar"><i class="bi bi-search"></i></button>
                                <a class="btn-circulo btn-oscuro" asp-page="/Membresia" title="Limpiar"><i class="bi bi-stars"></i></a>
                                <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                @if (Model.Membresias.Count > 0)
                {
                    <div class="table-responsive tabla-gestion">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="col-accion">Editar</th>
                                    <th class="col-accion">Eliminar</th>
                                    <th>Membresía</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Clases/sem</th>
                                    <th>Aforo</th>
                                    <th class="text-center">Activas</th>
                                    <th>Estatus</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow fila in Model.Membresias)
                                {
                                    var id = fila["IdTipoMembresia"];
                                    bool activo = Convert.ToInt32(fila["IdEstatus"]) == 1;
                                    var rutaEditar = Model.RutaFiltros();
                                    rutaEditar["id"] = id.ToString()!;

                                    <tr class="@(Model.Membresia.IdTipoMembresia.ToString() == id.ToString() ? "fila-seleccionada" : "")">
                                        <td class="col-accion">
                                            <a class="btn-circulo btn-sm-circulo btn-amarillo" title="Editar"
                                               asp-page="/Membresia" asp-page-handler="Editar" asp-all-route-data="rutaEditar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                        <td class="col-accion">
                                            <button type="button" class="btn-circulo btn-sm-circulo btn-rojo" title="Eliminar"
                                                    data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                    data-id="@id" data-nombre="@fila["Nombre"]">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <span class="etiqueta @ClasePlan(fila["Nombre"].ToString()!)">@fila["Nombre"]</span>
                                            <div class="small text-secondary">@fila["Descripcion"]</div>
                                        </td>
                                        <td class="text-end fw-semibold">@Convert.ToDecimal(fila["Precio"]).ToString("C2", new System.Globalization.CultureInfo("es-MX"))</td>
                                        <td class="text-center">@fila["MaxClasesSemana"]</td>
                                        <td>@fila["RestriccionAforo"]</td>
                                        <td class="text-center">@fila["SuscripcionesActivas"]</td>
                                        <td><span class="etiqueta @(activo ? "etiqueta-activo" : "etiqueta-inactivo")">@fila["Estatus"]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paginacion" model="Model" />
                }
                else
                {
                    <div class="sin-registros">
                        <i class="bi bi-inbox"></i>
                        No se encontraron registros con los parámetros solicitados.
                    </div>
                }
            </div>
        </div>

    </div>
</section>
