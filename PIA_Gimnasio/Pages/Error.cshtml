@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="gestion">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-gestion text-center p-5">
                <div class="icono-alerta"><i class="bi bi-exclamation-octagon-fill"></i></div>
                <h4 class="fw-bold">Ocurrió un error</h4>
                <p class="text-secondary">
                    No se pudo completar la operación. Intenta de nuevo; si el problema sigue, contacta al administrador del sistema.
                </p>
                <a class="btn btn-naranja mt-2" asp-page="/Inicio"><i class="bi bi-house me-1"></i>Ir al inicio</a>
            </div>
        </div>
    </div>
</section>
