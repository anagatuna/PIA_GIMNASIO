@page
@model PIA_Gimnasio.Pages.SuscripcionModel
@{
    ViewData["Title"] = "Suscripciones";
    ViewData["AnchoCompleto"] = true;
    ViewData["EliminarTitulo"] = "¿Cancelar suscripción?";
    ViewData["EliminarDescripcion"] = "perderá el acceso al gimnasio y a las clases. Después se le puede vender una nueva.";
    var inicio = Model.Suscripcion.FechaInicio ?? DateTime.Today;
}

<section class="gestion">
    <div class="row g-4">

        <!-- Venta / renovación -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center"><i class="bi bi-credit-card-2-front"></i>&nbsp;Nueva suscripción</h4>

                <form method="post" asp-page-handler="Guardar" asp-all-route-data="Model.RutaFiltros()">
                    <h6 class="subtitulo-seccion">Venta</h6>
                    <div class="form-floating mb-1">
                        <select asp-for="Suscripcion.IdCliente" asp-items="Model.Socios" class="form-select" required>
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Suscripcion.IdCliente">Socio<span class="asterisco"> *</span></label>
                    </div>
                    <small class="ayuda">Folio - nombre. ¿No aparece? <a asp-page="/Socio">Regístralo primero</a>.</small>

                    <div class="form-floating mb-3">
                        <select asp-for="Suscripcion.IdTipoMembresia" asp-items="Model.Membresias" class="form-select" required>
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Suscripcion.IdTipoMembresia">Membresía<span class="asterisco"> *</span></label>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Suscripcion.FechaInicio" type="date" class="form-control" id="fechaInicio"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" required />
                                <label asp-for="Suscripcion.FechaInicio">Inicio<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input class="form-control" id="fechaVencimiento" readonly tabindex="-1"
                                       value="@PIA_Gimnasio.Entidades.bdSuscripcion.CalcularVencimiento(inicio).ToString("dd/MM/yyyy")" />
                                <label>Vence (1 mes)</label>
                            </div>
                        </div>
                    </div>

                    <div class="nota">
                        <strong>Regla:</strong> un socio solo puede tener <b>1 suscripción activa</b>.
                        Para cambiar de plan, cancela la actual primero.
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="submit" class="btn btn-naranja"><i class="bi bi-cart-check me-1"></i>Registrar venta</button>
                        <a class="btn btn-oscuro" asp-page="/Suscripcion">Limpiar</a>
                    </div>
                </form>

                <hr />
                <h5 class="titulo-card text-center"><i class="bi bi-info-circle-fill"></i>&nbsp;Información</h5>
                <div class="info">
                    La vigencia se calcula automáticamente: <b>1 mes</b> a partir de la fecha de inicio.
                    Al pasar la fecha de vencimiento la suscripción cambia sola a <b>Vencida</b> y
                    aparece el botón <b>Renovar</b>.
                </div>
            </div>
        </div>

        <!-- Consulta de registros -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                <h4 class="titulo-card"><i class="bi bi-grid-3x3-gap"></i>&nbsp;Consulta registros: <span class="resaltado">Suscripciones</span></h4>

                <p class="mb-2"><strong><i class="bi bi-funnel"></i>&nbsp;Área de búsqueda</strong></p>
                <form method="get">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <input asp-for="Busqueda" class="form-control" placeholder="Folio o nombre" maxlength="50" />
                                <label asp-for="Busqueda">Folio o nombre</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdTipoMembresia" asp-items="Model.MembresiasFiltro" class="form-select">
                                    <option value="">Todas</option>
                                </select>
                                <label asp-for="BusquedaIdTipoMembresia">Membresía</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdEstatus" asp-items="Model.Estatus" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdEstatus">Estatus</label>
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn-circulo btn-naranja" title="Buscar"><i class="bi bi-search"></i></button>
                                <a class="btn-circulo btn-oscuro" asp-page="/Suscripcion" title="Limpiar"><i class="bi bi-stars"></i></a>
                                <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                @if (Model.Suscripciones.Count > 0)
                {
                    <div class="table-responsive tabla-gestion">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="col-accion">Acción</th>
                                    <th>Folio</th>
                                    <th>Socio</th>
                                    <th>Membresía</th>
                                    <th>Vigencia</th>
                                    <th>Estatus</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow fila in Model.Suscripciones)
                                {
                                    int estatus = Convert.ToInt32(fila["IdEstatus"]);
                                    int dias = Convert.ToInt32(fila["DiasRestantes"]);
                                    string clase = estatus switch { 1 => "etiqueta-activo", 3 => "etiqueta-avanzado", _ => "etiqueta-inactivo" };

                                    <tr>
                                        <td class="col-accion">
                                            @if (estatus == 1)
                                            {
                                                <button type="button" class="btn-circulo btn-sm-circulo btn-rojo" title="Cancelar"
                                                        data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                        data-id="@fila["IdSuscripcion"]" data-nombre="@fila["Socio"]">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else if (Convert.ToInt32(fila["PuedeRenovar"]) == 1)
                                            {
                                                <a class="btn-circulo btn-sm-circulo btn-verde" title="Renovar"
                                                   asp-page="/Suscripcion" asp-route-idCliente="@fila["IdCliente"]" asp-route-idTipoMembresia="@fila["IdTipoMembresia"]">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </a>
                                            }
                                        </td>
                                        <td class="fw-bold">@fila["Folio"]</td>
                                        <td>@fila["Socio"]</td>
                                        <td>
                                            @fila["Membresia"]
                                            <div class="small text-secondary">@Convert.ToDecimal(fila["Precio"]).ToString("C2", new System.Globalization.CultureInfo("es-MX"))</div>
                                        </td>
                                        <td class="text-nowrap">
                                            @Convert.ToDateTime(fila["FechaInicio"]).ToString("dd/MM/yyyy") – @Convert.ToDateTime(fila["FechaVencimiento"]).ToString("dd/MM/yyyy")
                                            @if (estatus == 1)
                                            {
                                                <div class="small @(dias <= 5 ? "text-danger fw-semibold" : "text-secondary")">
                                                    @(dias == 0 ? "Vence hoy" : $"Quedan {dias} días")
                                                </div>
                                            }
                                        </td>
                                        <td><span class="etiqueta @clase">@fila["Estatus"]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paginacion" model="Model" />
                }
                else
                {
                    <div class="sin-registros">
                        <i class="bi bi-inbox"></i>
                        No se encontraron registros con los parámetros solicitados.
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        // Muestra la fecha de vencimiento (1 mes menos 1 día, igual que spSuscripcion)
        document.getElementById('fechaInicio').addEventListener('change', function () {
            const salida = document.getElementById('fechaVencimiento');
            if (!this.value) { salida.value = ''; return; }
            const [a, m, d] = this.value.split('-').map(Number);
            const vence = new Date(a, m, d);          // mismo día del mes siguiente
            if (vence.getDate() !== d) vence.setDate(0); // 31 ene -> 28/29 feb (igual que DATEADD)
            vence.setDate(vence.getDate() - 1);
            salida.value = vence.toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' });
        });
    </script>
}
