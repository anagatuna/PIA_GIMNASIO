@page
@model PIA_Gimnasio.Pages.PaseListaModel
@using PIA_Gimnasio.Logica
@{
    ViewData["Title"] = "Pase de lista";
    ViewData["AnchoCompleto"] = true;
    // Hora en formato 08:30 (vacío si no hay)
    string Hora(object valor)
    {
        if (valor == DBNull.Value)
            return "";
        return ((TimeSpan)valor).ToString(@"hh\:mm");
    }
    var clase = Model.ClaseActual;
    bool puedePasarLista = clase != null && Convert.ToInt32(clase["PuedePasarLista"]) == 1;
    // Socios que todavía no tienen asistencia registrada
    int sinMarcar = 0;
    foreach (DataRow p in Model.Participantes)
    {
        if (Convert.ToInt32(p["IdEstatus"]) == logicaPaseLista.Pendiente)
            sinMarcar++;
    }
}

<section class="gestion">
    <div class="row g-4">

        <!-- Clases del día -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center"><i class="bi bi-calendar-day"></i>&nbsp;@(Model.EsEntrenador ? "Mis clases" : "Clases del día")</h4>

                <form method="get" class="d-flex align-items-center gap-2 mb-3">
                    <a class="btn-circulo btn-oscuro" title="Día anterior" asp-page="/PaseLista" asp-route-Fecha="@Model.Dia.AddDays(-1).ToString("yyyy-MM-dd")"><i class="bi bi-chevron-left"></i></a>
                    <div class="form-floating flex-grow-1">
                        <input id="Fecha" name="Fecha" type="date" class="form-control" value="@Model.Dia.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                        <label for="Fecha">@Model.Dia.ToString("dddd")</label>
                    </div>
                    <a class="btn-circulo btn-oscuro" title="Día siguiente" asp-page="/PaseLista" asp-route-Fecha="@Model.Dia.AddDays(1).ToString("yyyy-MM-dd")"><i class="bi bi-chevron-right"></i></a>
                </form>

                @if (Model.Clases.Count == 0)
                {
                    <div class="sin-registros"><i class="bi bi-calendar-x"></i>No hay clases programadas este día.</div>
                }
                <div class="d-flex flex-column gap-2">
                    @foreach (DataRow c in Model.Clases)
                    {
                        var id = Convert.ToInt32(c["IdClase"]);
                        int pendientes = Convert.ToInt32(c["Pendientes"]);
                        <a class="agenda-clase tarjeta-clase @(id == Model.IdClase ? "seleccionada" : "")"
                           asp-page="/PaseLista" asp-route-Fecha="@Model.Dia.ToString("yyyy-MM-dd")" asp-route-IdClase="@id">
                            <div class="d-flex justify-content-between">
                                <span class="nombre">@c["Nombre"]</span>
                                <span class="hora">@Hora(c["HoraInicio"]) - @Hora(c["HoraFin"])</span>
                            </div>
                            <div class="detalle">@c["Salon"] · @c["Sucursal"]@(Model.EsEntrenador ? "" : " · " + c["Entrenador"])</div>
                            <div class="cupo">
                                <i class="bi bi-people"></i> @c["Reservadas"] / @c["CupoMaximo"]
                                <span class="text-success ms-2"><i class="bi bi-check-lg"></i> @c["Asistieron"]</span>
                                <span class="text-danger ms-2"><i class="bi bi-x-lg"></i> @c["Faltas"]</span>
                                @if (pendientes > 0 && Convert.ToInt32(c["PuedePasarLista"]) == 1)
                                {
                                    <span class="etiqueta etiqueta-rol ms-1">@pendientes por pasar</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Lista de participantes -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                @if (clase == null)
                {
                    <div class="sin-registros"><i class="bi bi-list-check"></i>Selecciona una clase para pasar lista.</div>
                }
                else
                {
                    <h4 class="titulo-card"><i class="bi bi-list-check"></i>&nbsp;Pase de lista: <span class="resaltado">@clase["Nombre"]</span></h4>
                    <p class="text-secondary small mb-3">
                        @Model.Dia.ToString("dddd dd 'de' MMMM") · @Hora(clase["HoraInicio"]) - @Hora(clase["HoraFin"]) · @clase["Salon"] · @clase["Entrenador"]
                    </p>

                    @if (!puedePasarLista && Model.Dia < DateTime.Today)
                    {
                        // Clase de un día anterior: el pase de lista solo se hace el mismo día
                        <div class="resumen-plan sin-plan mb-3">
                            <i class="bi bi-lock"></i> El pase de lista solo se puede hacer el mismo día de la clase.
                        </div>
                    }
                    else if (!puedePasarLista)
                    {
                        <div class="resumen-plan al-limite mb-3">
                            <i class="bi bi-clock"></i> La clase todavía no comienza; podrás registrar la asistencia a partir de las @Hora(clase["HoraInicio"]).
                        </div>
                    }

                    @if (Model.Participantes.Count == 0)
                    {
                        <div class="sin-registros"><i class="bi bi-person-x"></i>Esta clase no tiene reservas confirmadas.</div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Guardar" asp-route-Fecha="@Model.Dia.ToString("yyyy-MM-dd")" asp-route-IdClase="@Model.IdClase" id="formAsistencia">
                            @if (puedePasarLista && sinMarcar > 0)
                            {
                                <div class="d-flex justify-content-end mb-2">
                                    <button type="button" class="btn btn-verde btn-sm-pill" id="todosAsistieron"><i class="bi bi-check2-all me-1"></i>Todos asistieron</button>
                                </div>
                            }

                            <div class="lista-asistencia">
                                @foreach (DataRow p in Model.Participantes)
                                {
                                    var idReserva = p["IdReserva"];
                                    int estatus = Convert.ToInt32(p["IdEstatus"]);
                                    // Solo puede marcarse "Asistió" si el socio registró su entrada ese día en la sucursal
                                    bool tuvoEntrada = Convert.ToInt32(p["TuvoEntrada"]) == 1;
                                    <div class="fila-asistencia">
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">@p["Socio"]</div>
                                            <div class="small text-secondary">
                                                Folio @p["Folio"] ·
                                                @if (tuvoEntrada)
                                                {
                                                    <span class="text-success"><i class="bi bi-door-open"></i> Con entrada</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger"><i class="bi bi-door-closed"></i> Sin entrada registrada</span>
                                                }
                                            </div>
                                        </div>
                                        @if (estatus == logicaPaseLista.Asistio)
                                        {
                                            // Ya registrada: no se puede cambiar
                                            <span class="etiqueta etiqueta-activo"><i class="bi bi-check-lg"></i> ASISTIÓ</span>
                                        }
                                        else if (estatus == logicaPaseLista.Falta)
                                        {
                                            <span class="etiqueta etiqueta-inactivo"><i class="bi bi-x-lg"></i> FALTA</span>
                                        }
                                        else
                                        {
                                            <div class="opciones-asistencia" role="radiogroup">
                                                @* "Asistió" solo se habilita si el socio registró su entrada ese día *@
                                                <label class="opcion asistio" title="@(puedePasarLista && !tuvoEntrada ? "Sin entrada registrada" : "Asistió")">
                                                    <input type="radio" name="Asistencia[@idReserva]" value="@logicaPaseLista.Asistio" disabled="@(!puedePasarLista || !tuvoEntrada)" />
                                                    <span><i class="bi bi-check-lg"></i> <span class="d-none d-sm-inline">Asistió</span></span>
                                                </label>
                                                <label class="opcion falta" title="Falta">
                                                    <input type="radio" name="Asistencia[@idReserva]" value="@logicaPaseLista.Falta" disabled="@(!puedePasarLista)" />
                                                    <span><i class="bi bi-x-lg"></i> <span class="d-none d-sm-inline">Falta</span></span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (puedePasarLista && sinMarcar > 0)
                            {
                                <div class="d-flex justify-content-center mt-4">
                                    @* Primero pide confirmación: la asistencia ya no se puede cambiar *@
                                    <button type="button" class="btn btn-naranja" data-bs-toggle="modal" data-bs-target="#modalConfirmarAsistencia">
                                        <i class="bi bi-floppy me-1"></i>Guardar pase de lista
                                    </button>
                                </div>
                            }
                            else if (sinMarcar == 0)
                            {
                                <div class="small text-secondary text-center mt-3"><i class="bi bi-lock"></i> El pase de lista de esta clase ya está completo.</div>
                            }
                        </form>

                        <!-- Ventana de confirmación antes de guardar -->
                        <div class="modal fade" id="modalConfirmarAsistencia" tabindex="-1" aria-labelledby="modalConfirmarLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content modal-gestion">
                                    <div class="modal-body text-center p-4">
                                        <div class="icono-alerta"><i class="bi bi-exclamation-triangle-fill"></i></div>
                                        <h5 id="modalConfirmarLabel" class="fw-bold">¿Guardar el pase de lista?</h5>
                                        <p class="text-secondary mb-0">
                                            Una vez guardada, la asistencia (<b>Asistió</b> o <b>Falta</b>) ya no se puede cambiar.
                                            Los socios que no marques quedan pendientes.
                                        </p>
                                    </div>
                                    <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                                        <button type="button" class="btn btn-oscuro" data-bs-dismiss="modal">Revisar</button>
                                        <button type="submit" form="formAsistencia" class="btn btn-naranja">Sí, guardar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        // Botón "Todos asistieron": marca la opción Asistió de cada socio
        var botonTodos = document.getElementById('todosAsistieron');
        if (botonTodos != null) {
            botonTodos.addEventListener('click', function () {
                var opciones = document.querySelectorAll('.opcion.asistio input');
                for (var i = 0; i < opciones.length; i++) {
                    // Se salta a los socios sin entrada registrada (su opción "Asistió" está deshabilitada)
                    if (!opciones[i].disabled)
                        opciones[i].checked = true;
                }
            });
        }
    </script>
}
