@page
@model PIA_Gimnasio.Pages.EmpleadoModel
@{
    ViewData["Title"] = "Empleados";
    ViewData["AnchoCompleto"] = true;
    ViewData["EliminarTitulo"] = "¿Eliminar empleado?";
    ViewData["EliminarDescripcion"] = "se dará de baja. Si tiene cuenta de usuario, también se dará de baja (relación 1:1).";
    bool esEdicion = Model.Empleado.IdEmpleado > 0;
}

<section class="gestion">
    <div class="row g-4">

        <!-- Gestión de información -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center">
                    <i class="bi bi-person-workspace"></i>&nbsp;@(esEdicion ? "Editar empleado" : "Nuevo empleado")
                </h4>

                <form method="post" asp-page-handler="Guardar" asp-all-route-data="Model.RutaFiltros()">
                    <input type="hidden" asp-for="Empleado.IdEmpleado" />

                    <!-- Datos personales -->
                    <h6 class="subtitulo-seccion">Datos personales</h6>
                    <div class="form-floating mb-3">
                        <input asp-for="Empleado.Nombre" class="form-control" placeholder="Nombre" maxlength="50" autocomplete="off" required />
                        <label asp-for="Empleado.Nombre">Nombre(s)<span class="asterisco"> *</span></label>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.PrimerApellido" class="form-control" placeholder="Primer apellido" maxlength="50" required />
                                <label asp-for="Empleado.PrimerApellido">Primer apellido<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.SegundoApellido" class="form-control" placeholder="Segundo apellido" maxlength="50" />
                                <label asp-for="Empleado.SegundoApellido">Segundo apellido</label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.CURP" class="form-control text-uppercase" placeholder="CURP" maxlength="18" />
                                <label asp-for="Empleado.CURP">CURP</label>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.RFC" class="form-control text-uppercase" placeholder="RFC" maxlength="13" />
                                <label asp-for="Empleado.RFC">RFC</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Empleado.FechaNacimiento" type="date" class="form-control" required />
                        <label asp-for="Empleado.FechaNacimiento">Fecha de nacimiento<span class="asterisco"> *</span></label>
                    </div>
                    <div class="row">
                        <div class="col-7 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.Correo" type="email" class="form-control" placeholder="Correo" maxlength="50" required />
                                <label asp-for="Empleado.Correo">Correo<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-5 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.Telefono" class="form-control" placeholder="Teléfono" maxlength="10" pattern="\d{10}" title="10 dígitos" inputmode="numeric" required />
                                <label asp-for="Empleado.Telefono">Teléfono<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Asignación laboral -->
                    <h6 class="subtitulo-seccion">Asignación laboral</h6>
                    <div class="form-floating mb-3">
                        <select asp-for="Empleado.IdSucursal" asp-items="Model.Sucursales" class="form-select" required>
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Empleado.IdSucursal">Sucursal<span class="asterisco"> *</span></label>
                    </div>
                    <div class="row">
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Empleado.IdPuesto" asp-items="Model.Puestos" class="form-select" required
                                        id="selPuesto" data-entrenador="@Model.IdPuestoEntrenador">
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Empleado.IdPuesto">Puesto<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Empleado.FechaContratacion" type="date" class="form-control" required />
                                <label asp-for="Empleado.FechaContratacion">Contratación<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <!-- Sección dinámica: solo para el puesto Entrenador -->
                    <fieldset id="seccionEspecialidades" class="especialidades @(Model.EsPuestoEntrenador ? "" : "deshabilitada")" disabled="@(!Model.EsPuestoEntrenador)">
                        <legend class="subtitulo-seccion mb-2">Especialidades<span class="asterisco"> *</span></legend>
                        <div class="lista-especialidades">
                            @foreach (var esp in Model.Especialidades)
                            {
                                var marcado = Model.Empleado.Especialidades.Contains(int.Parse(esp.Value));
                                <label class="chip-check">
                                    <input type="checkbox" name="Empleado.Especialidades" value="@esp.Value" checked="@marcado" />
                                    <span>@esp.Text</span>
                                </label>
                            }
                        </div>
                        <small class="ayuda" id="ayudaEspecialidades">
                            @(Model.EsPuestoEntrenador ? "Marca las disciplinas que puede impartir." : "Se habilitan al seleccionar el puesto Entrenador.")
                        </small>
                    </fieldset>

                    <div class="form-floating mb-3 mt-3">
                        <select asp-for="Empleado.IdEstatus" asp-items="Model.Estatus" class="form-select" required>
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Empleado.IdEstatus">Estatus<span class="asterisco"> *</span></label>
                    </div>

                    <div class="nota">
                        <strong>Nota:</strong> Los campos obligatorios están marcados con
                        <abbr title="obligatorio" class="asterisco">*</abbr>. La cuenta de acceso se crea en <a asp-page="/Usuario">Usuarios</a>.
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="submit" class="btn btn-naranja">
                            <i class="bi bi-floppy me-1"></i>@(esEdicion ? "Actualizar" : "Guardar")
                        </button>
                        <a class="btn btn-oscuro" asp-page="/Empleado" asp-all-route-data="Model.RutaFiltros()">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Consulta de registros -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                <h4 class="titulo-card"><i class="bi bi-grid-3x3-gap"></i>&nbsp;Consulta registros: <span class="resaltado">Empleados</span></h4>

                <p class="mb-2"><strong><i class="bi bi-funnel"></i>&nbsp;Área de búsqueda</strong></p>
                <form method="get">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="form-floating">
                                <input asp-for="BusquedaNombre" class="form-control" placeholder="Búsqueda por nombre" maxlength="50" />
                                <label asp-for="BusquedaNombre">Búsqueda por nombre</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdSucursal" asp-items="Model.Sucursales" class="form-select">
                                    <option value="">Todas</option>
                                </select>
                                <label asp-for="BusquedaIdSucursal">Sucursal</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdPuesto" asp-items="Model.Puestos" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdPuesto">Puesto</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdEstatus" asp-items="Model.Estatus" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdEstatus">Estatus</label>
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn-circulo btn-naranja" title="Buscar"><i class="bi bi-search"></i></button>
                                <a class="btn-circulo btn-oscuro" asp-page="/Empleado" title="Limpiar"><i class="bi bi-stars"></i></a>
                                <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                @if (Model.Empleados.Count > 0)
                {
                    <div class="table-responsive tabla-gestion">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="col-accion">Editar</th>
                                    <th class="col-accion">Eliminar</th>
                                    <th>Empleado</th>
                                    <th>Puesto</th>
                                    <th>Sucursal</th>
                                    <th>Cuenta</th>
                                    <th>Estatus</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow fila in Model.Empleados)
                                {
                                    var id = fila["IdEmpleado"];
                                    bool activo = Convert.ToInt32(fila["IdEstatus"]) == 1;
                                    var rutaEditar = Model.RutaFiltros();
                                    rutaEditar["id"] = id.ToString()!;

                                    <tr class="@(Model.Empleado.IdEmpleado.ToString() == id.ToString() ? "fila-seleccionada" : "")">
                                        <td class="col-accion">
                                            <a class="btn-circulo btn-sm-circulo btn-amarillo" title="Editar"
                                               asp-page="/Empleado" asp-page-handler="Editar" asp-all-route-data="rutaEditar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                        <td class="col-accion">
                                            <button type="button" class="btn-circulo btn-sm-circulo btn-rojo" title="Eliminar"
                                                    data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                    data-id="@id" data-nombre="@fila["Empleado"]">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@fila["Empleado"]</div>
                                            <div class="small text-secondary">@fila["Correo"] · @fila["Telefono"]</div>
                                        </td>
                                        <td>
                                            @fila["Puesto"]
                                            @if (fila["Especialidades"] != DBNull.Value)
                                            {
                                                <div class="small text-secondary"><i class="bi bi-award"></i> @fila["Especialidades"]</div>
                                            }
                                        </td>
                                        <td>@fila["Sucursal"]</td>
                                        <td>
                                            @if (fila["Cuenta"] != DBNull.Value)
                                            {
                                                <span class="etiqueta etiqueta-rol"><i class="bi bi-person-lock"></i> @fila["Cuenta"]</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">Sin cuenta</span>
                                            }
                                        </td>
                                        <td><span class="etiqueta @(activo ? "etiqueta-activo" : "etiqueta-inactivo")">@fila["Estatus"]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paginacion" model="Model" />
                }
                else
                {
                    <div class="sin-registros">
                        <i class="bi bi-inbox"></i>
                        No se encontraron registros con los parámetros solicitados.
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        // Habilita las especialidades solo si el puesto seleccionado es Entrenador
        (function () {
            const puesto = document.getElementById('selPuesto');
            const seccion = document.getElementById('seccionEspecialidades');
            const ayuda = document.getElementById('ayudaEspecialidades');

            function actualizar() {
                const esEntrenador = puesto.value !== '' && puesto.value === puesto.dataset.entrenador;
                seccion.disabled = !esEntrenador;
                seccion.classList.toggle('deshabilitada', !esEntrenador);
                ayuda.textContent = esEntrenador ? 'Marca las disciplinas que puede impartir.' : 'Se habilitan al seleccionar el puesto Entrenador.';
                if (!esEntrenador)
                    seccion.querySelectorAll('input[type=checkbox]').forEach(c => c.checked = false);
            }

            puesto.addEventListener('change', actualizar);
        })();
    </script>
}
