@page
@model PIA_Gimnasio.Pages.ReservaModel
@{
    ViewData["Title"] = "Reservas";
    ViewData["AnchoCompleto"] = true;
    ViewData["EliminarTitulo"] = "¿Cancelar reserva?";
    ViewData["EliminarDescripcion"] = "liberará su lugar en la clase y dejará de contar en su límite semanal.";
    // Hora en formato 08:30 (vacío si no hay)
    string Hora(object valor)
    {
        if (valor == DBNull.Value)
            return "";
        return ((TimeSpan)valor).ToString(@"hh\:mm");
    }
}

<section class="gestion">
    <div class="row g-4">

        <!-- Captura -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center"><i class="bi bi-bookmark-plus"></i>&nbsp;Nueva reserva</h4>

                <form method="post" asp-page-handler="Guardar">
                    <div class="form-floating mb-3">
                        <select asp-for="Reserva.IdCliente" asp-items="Model.Socios" class="form-select" required onchange="mostrarResumen(this.form)">
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Reserva.IdCliente">Socio<span class="asterisco"> *</span></label>
                    </div>

                    <!-- Plan del socio y uso semanal (lo calcula el servidor al elegir socio o clase) -->
                    @if (Model.Reserva.IdCliente == null)
                    {
                        <div class="resumen-plan mb-3"><i class="bi bi-info-circle"></i> Elige un socio para ver cuántas clases le quedan en la semana.</div>
                    }
                    else if (Model.Resumen == null || Model.Resumen["Membresia"] == DBNull.Value)
                    {
                        <div class="resumen-plan sin-plan mb-3">
                            <i class="bi bi-x-octagon"></i> Sin membresía vigente @(Model.Reserva.IdClase == null ? "hoy" : "en la fecha de la clase"): no puede reservar.
                        </div>
                    }
                    else
                    {
                        int maximo = Convert.ToInt32(Model.Resumen["MaxClasesSemana"]);
                        int usadas = Convert.ToInt32(Model.Resumen["Usadas"]);
                        int disponibles = maximo - usadas;
                        if (disponibles < 0)
                            disponibles = 0;

                        <div class="resumen-plan @(disponibles == 0 ? "al-limite" : "") mb-3">
                            <i class="bi bi-tags"></i> Plan <b>@Model.Resumen["Membresia"]</b> (vence @Convert.ToDateTime(Model.Resumen["FechaVencimiento"]).ToString("dd/MM/yyyy"))<br />
                            @if (maximo == 0)
                            {
                                <span>Su plan no incluye clases grupales.</span>
                            }
                            else
                            {
                                <span>
                                    @(Model.Reserva.IdClase == null ? "Esta semana" : "Semana del " + Convert.ToDateTime(Model.Resumen["Lunes"]).ToString("dd/MM/yyyy")):
                                    <b>@usadas de @maximo</b> clases · le quedan <b>@disponibles</b>
                                </span>
                            }
                        </div>
                    }

                    <div class="form-floating mb-1">
                        <select asp-for="Reserva.IdClase" asp-items="Model.Clases" class="form-select" required onchange="mostrarResumen(this.form)">
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Reserva.IdClase">Clase<span class="asterisco"> *</span></label>
                    </div>
                    <small class="ayuda">Aparecen las clases futuras (también de las semanas siguientes). Las llenas solo se pueden reservar con plan Oro.</small>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="submit" class="btn btn-naranja"><i class="bi bi-bookmark-check me-1"></i>Reservar</button>
                        <a class="btn btn-oscuro" asp-page="/Reserva">Limpiar</a>
                    </div>
                </form>

                <hr />
                <h5 class="titulo-card text-center"><i class="bi bi-info-circle-fill"></i>&nbsp;Validaciones automáticas</h5>
                <div class="info">
                    Al reservar se verifica que el socio tenga una <b>membresía vigente</b> en la fecha de la clase
                    y que no rebase su <b>límite semanal</b> (lunes a domingo): <b>Bronce 0</b>, <b>Plata 3</b>, <b>Oro 5</b>.
                    El plan <b>Plata</b> está sujeto al <b>cupo</b> del salón; el plan <b>Oro</b> no tiene restricción de aforo.
                </div>
            </div>
        </div>

        <!-- Consulta de registros -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                <h4 class="titulo-card"><i class="bi bi-grid-3x3-gap"></i>&nbsp;Consulta registros: <span class="resaltado">Reservas</span></h4>

                <p class="mb-2"><strong><i class="bi bi-funnel"></i>&nbsp;Área de búsqueda</strong></p>
                <form method="get" id="formBusqueda">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <input asp-for="Busqueda" class="form-control" placeholder="Folio o nombre" maxlength="50" />
                                <label asp-for="Busqueda">Folio o nombre</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <input asp-for="BusquedaFecha" type="date" class="form-control" />
                                <label asp-for="BusquedaFecha">Fecha de la clase</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdEstatus" asp-items="Model.Estatus" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdEstatus">Estatus</label>
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn-circulo btn-naranja" title="Buscar"><i class="bi bi-search"></i></button>
                                <a class="btn-circulo btn-oscuro" asp-page="/Reserva" title="Limpiar"><i class="bi bi-stars"></i></a>
                                <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                @if (Model.Reservas.Count > 0)
                {
                    <div class="table-responsive tabla-gestion">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="col-accion">Cancelar</th>
                                    <th>Folio</th>
                                    <th>Socio</th>
                                    <th>Clase</th>
                                    <th>Fecha</th>
                                    <th>Estatus</th>
                                    <th class="text-center" title="Clases que le quedan al socio en la semana de esa clase">Le quedan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow fila in Model.Reservas)
                                {
                                    int estatus = Convert.ToInt32(fila["IdEstatus"]);
                                    string clase = "etiqueta-inactivo";
                                    if (estatus == 5) clase = "etiqueta-activo";
                                    else if (estatus == 6) clase = "etiqueta-rol";

                                    <tr>
                                        <td class="col-accion">
                                            @if (Convert.ToInt32(fila["PuedeCancelar"]) == 1)
                                            {
                                                <button type="button" class="btn-circulo btn-sm-circulo btn-rojo" title="Cancelar"
                                                        data-bs-toggle="modal" data-bs-target="#modalEliminar" onclick="prepararEliminar(this)"
                                                        data-id="@fila["IdReserva"]" data-nombre="@fila["Socio"] – @fila["Clase"]">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                        </td>
                                        <td class="fw-bold">@fila["Folio"]</td>
                                        <td>@fila["Socio"]</td>
                                        <td>
                                            @fila["Clase"]
                                            <div class="small text-secondary">@fila["Salon"] · @fila["Sucursal"]</div>
                                        </td>
                                        <td class="text-nowrap">@Convert.ToDateTime(fila["Fecha"]).ToString("dd/MM/yyyy") @Hora(fila["HoraInicio"])</td>
                                        <td><span class="etiqueta @clase">@fila["Estatus"]</span></td>
                                        <td class="text-center text-nowrap">
                                            @if (fila["MaxClasesSemana"] == DBNull.Value)
                                            {
                                                <span class="small text-secondary">Sin plan</span>
                                            }
                                            else
                                            {
                                                // Clases disponibles esa semana (lunes a domingo): máximo del plan - reservas que cuentan
                                                int maximo = Convert.ToInt32(fila["MaxClasesSemana"]);
                                                int quedan = maximo - Convert.ToInt32(fila["UsadasSemana"]);
                                                if (quedan < 0)
                                                    quedan = 0;
                                                <b class="@(quedan == 0 ? "text-danger" : "text-success")">@quedan</b>
                                                <span class="small text-secondary">de @maximo</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paginacion" model="Model" />
                }
                else
                {
                    <div class="sin-registros">
                        <i class="bi bi-inbox"></i>
                        No se encontraron registros con los parámetros solicitados.
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        // Al elegir socio o clase se manda el formulario al handler Resumen (sin guardar la reserva)
        function mostrarResumen(formulario) {
            formulario.action = '?handler=Resumen';
            formulario.submit();
        }
    </script>
}
