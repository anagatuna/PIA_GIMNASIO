@page
@model PIA_Gimnasio.Pages.RutinaNuevaModel
@using PIA_Gimnasio.Logica
@using PIA_Gimnasio.Entidades
@{
    ViewData["Title"] = "Diseñador de rutinas";
    ViewData["AnchoCompleto"] = true;
}

<form method="post">
    <section class="gestion">
        <div class="row g-4">

            <!-- Cabecera de la rutina -->
            <div class="col-lg-4">
                <div class="card-gestion h-100">
                    <h4 class="titulo-card text-center"><i class="bi bi-clipboard2-pulse"></i>&nbsp;Nueva rutina</h4>

                    <h6 class="subtitulo-seccion">Asignación</h6>
                    <div class="form-floating mb-3">
                        <select asp-for="Rutina.IdCliente" asp-items="Model.Socios" class="form-select" required onchange="cambiarSocio(this.form)">
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Rutina.IdCliente">Socio<span class="asterisco"> *</span></label>
                    </div>

                    <div class="form-floating mb-1">
                        @if (Model.EsEntrenador)
                        {
                            <input type="hidden" asp-for="Rutina.IdEmpleado" />
                            <select asp-for="Rutina.IdEmpleado" asp-items="Model.Entrenadores" class="form-select" disabled>
                                <option value="">Sin empleado ligado</option>
                            </select>
                        }
                        else
                        {
                            <select asp-for="Rutina.IdEmpleado" asp-items="Model.Entrenadores" class="form-select" required>
                                <option value="">Selecciona...</option>
                            </select>
                        }
                        <label asp-for="Rutina.IdEmpleado">Entrenador<span class="asterisco"> *</span></label>
                    </div>
                    <small class="ayuda">@(Model.EsEntrenador ? "Las rutinas que diseñas quedan a tu nombre." : "Solo aparecen empleados activos con puesto Entrenador.")</small>

                    <div class="form-floating mb-3">
                        <input asp-for="Rutina.Nombre" class="form-control" placeholder="Nombre de la rutina" maxlength="50" autocomplete="off" required />
                        <label asp-for="Rutina.Nombre">Nombre de la rutina<span class="asterisco"> *</span></label>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Rutina.Objetivo" asp-items="Model.Objetivos" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Rutina.Objetivo">Objetivo<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Rutina.FechaAsignacion" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" required />
                                <label asp-for="Rutina.FechaAsignacion">Fecha de asignación<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Expediente médico -->
                    <h6 class="subtitulo-seccion"><i class="bi bi-heart-pulse"></i> Expediente médico</h6>
                    @if (Model.Rutina.IdCliente != null && Model.Expediente == null)
                    {
                        <div class="expediente-vacio sin-expediente">
                            <i class="bi bi-clipboard2-x"></i>
                            <span>Este socio no tiene expediente médico. Es obligatorio para asignarle una rutina.</span>
                        </div>
                    }
                    else
                    {
                        <partial name="_ExpedienteMedico" model="Model.Expediente" />
                    }

                    <hr />
                    <div class="info">
                        Arma la semana del socio agregando ejercicios a cada día. Si un ejercicio está contraindicado
                        para lo que registra su expediente médico, verás una <b>alerta</b> y tendrás que confirmarla para guardar.
                    </div>
                </div>
            </div>
            <!-- Fin Cabecera -->

            <!-- Matriz semanal -->
            <div class="col-lg-8">
                <div class="card-gestion h-100 d-flex flex-column">
                    <h4 class="titulo-card"><i class="bi bi-calendar-week"></i>&nbsp;Asignación semanal</h4>

                    <!-- Agregar ejercicio -->
                    <div class="row g-2 align-items-start mb-2">
                        <div class="col-6 col-md-2">
                            <div class="form-floating">
                                <select asp-for="NuevoDia" class="form-select">
                                    @foreach (string dia in logicaCatalogo.DiasSemana)
                                    {
                                        <option value="@dia">@dia</option>
                                    }
                                </select>
                                <label asp-for="NuevoDia">Día</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="form-floating">
                                <select asp-for="NuevoIdEjercicio" class="form-select">
                                    <option value="">Selecciona...</option>
                                    @* Los ejercicios vienen ordenados por grupo muscular (spCatalogo).
                                       Cada vez que cambia el grupo se cierra el optgroup anterior y se abre uno nuevo. *@
                                    @{ string grupoActual = ""; }
                                    @foreach (DataRow e in Model.Ejercicios)
                                    {
                                        string grupo = e["GrupoMuscular"].ToString() ?? "";
                                        int idEjercicio = Convert.ToInt32(e["IdCatalogo"]);
                                        // Los contraindicados para el socio se marcan con ⚠
                                        string marca = Model.AlertasPorEjercicio.ContainsKey(idEjercicio) ? "⚠ " : "";
                                        if (grupo != grupoActual)
                                        {
                                            if (grupoActual != "")
                                            {
                                                @:</optgroup>
                                            }
                                            @:<optgroup label="@grupo">
                                            grupoActual = grupo;
                                        }
                                        <option value="@idEjercicio">@marca@e["Descripcion"] · @e["NivelDificultad"]</option>
                                    }
                                    @if (grupoActual != "")
                                    {
                                        @:</optgroup>
                                    }
                                </select>
                                <label asp-for="NuevoIdEjercicio">Ejercicio</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input asp-for="NuevoSeries" type="number" class="form-control" min="1" step="1" placeholder="Series" />
                                <label asp-for="NuevoSeries">Series</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input asp-for="NuevoRepeticiones" type="number" class="form-control" min="1" placeholder="Repeticiones" />
                                <label asp-for="NuevoRepeticiones">Reps</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input asp-for="NuevoDescanso" type="number" class="form-control" min="0" placeholder="Descanso" />
                                <label asp-for="NuevoDescanso">Descanso (s)</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <button type="submit" class="btn btn-naranja btn-sm-pill" asp-page-handler="Agregar" formnovalidate>
                            <i class="bi bi-plus-lg me-1"></i>Agregar al día
                        </button>
                    </div>

                    <!-- Matriz Lunes a Domingo -->
                    <div class="matriz-semanal">
                        @foreach (string dia in logicaCatalogo.DiasSemana)
                        {
                            // Cuántos ejercicios tiene el día
                            int cantidad = 0;
                            foreach (bdDetalleRutina d in Model.Rutina.Detalles)
                            {
                                if (d.DiaSemana == dia)
                                    cantidad++;
                            }

                            <div class="dia-col">
                                <div class="dia-titulo">@dia<span>@cantidad</span></div>
                                <div class="dia-items">
                                    @if (cantidad == 0)
                                    {
                                        <div class="dia-vacio">Descanso</div>
                                    }
                                    @for (int i = 0; i < Model.Rutina.Detalles.Count; i++)
                                    {
                                        bdDetalleRutina d = Model.Rutina.Detalles[i];
                                        if (d.DiaSemana != dia)
                                            continue;

                                        DataRow? ejercicio = Model.BuscarEjercicio(d.IdEjercicio);
                                        string alerta = "";
                                        if (Model.AlertasPorEjercicio.ContainsKey(d.IdEjercicio))
                                            alerta = Model.AlertasPorEjercicio[d.IdEjercicio];

                                        <div class="ejercicio-dia @(alerta != "" ? "con-alerta" : "")" title="@alerta">
                                            <button type="submit" class="quitar" asp-page-handler="Quitar" asp-route-indice="@i" formnovalidate aria-label="Quitar"><i class="bi bi-x"></i></button>
                                            <div class="nombre">
                                                @if (alerta != "")
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                }
                                                @(ejercicio == null ? "Ejercicio inactivo" : ejercicio["Descripcion"])
                                            </div>
                                            <div class="grupo">@(ejercicio == null ? "" : ejercicio["GrupoMuscular"])</div>
                                            <div class="metricas">@d.Series×@d.Repeticiones · @(d.TiempoDescanso)s</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Ejercicios de la rutina en campos ocultos: viajan con cada botón del formulario -->
                    @for (int i = 0; i < Model.Rutina.Detalles.Count; i++)
                    {
                        bdDetalleRutina d = Model.Rutina.Detalles[i];
                        <input type="hidden" name="Rutina.Detalles[@i].DiaSemana" value="@d.DiaSemana" />
                        <input type="hidden" name="Rutina.Detalles[@i].IdEjercicio" value="@d.IdEjercicio" />
                        <input type="hidden" name="Rutina.Detalles[@i].Series" value="@d.Series" />
                        <input type="hidden" name="Rutina.Detalles[@i].Repeticiones" value="@d.Repeticiones" />
                        <input type="hidden" name="Rutina.Detalles[@i].TiempoDescanso" value="@d.TiempoDescanso" />
                    }

                    <!-- Alertas médicas -->
                    @if (Model.Alertas.Count > 0)
                    {
                        <div class="panel-alertas">
                            <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Alertas médicas</div>
                            <ul class="mb-2">
                                @foreach (string alerta in Model.Alertas)
                                {
                                    <li>@alerta</li>
                                }
                            </ul>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="ConfirmarAlertas" />
                                <label class="form-check-label" asp-for="ConfirmarAlertas">
                                    Revisé las alertas y confirmo que el socio puede realizar estos ejercicios.
                                </label>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-auto pt-4">
                        <a class="btn btn-oscuro" asp-page="/Rutina">Cancelar</a>
                        <button type="submit" class="btn btn-naranja">
                            <i class="bi bi-floppy me-1"></i>Guardar rutina
                        </button>
                    </div>
                </div>
            </div>
            <!-- Fin Matriz semanal -->

        </div>
    </section>
</form>

@section Scripts {
    <script>
        // Al cambiar de socio se manda el formulario al handler Socio (recarga su expediente sin guardar)
        function cambiarSocio(formulario) {
            formulario.action = '?handler=Socio';
            formulario.submit();
        }
    </script>
}
