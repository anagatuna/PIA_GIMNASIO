@page
@model PIA_Gimnasio.Pages.RutinaNuevaModel
@using System.Text.Json
@using PIA_Gimnasio.Logica
@{
    ViewData["Title"] = "Diseñador de rutinas";
    ViewData["AnchoCompleto"] = true;

    // Datos que usa el JavaScript del diseñador.
    // Ejercicios por Id: { "1": { nombre, grupo, nivel, contra }, "2": {...} }
    Dictionary<string, object> ejercicios = new Dictionary<string, object>();
    foreach (DataRow e in Model.Ejercicios)
    {
        ejercicios[e["IdEjercicio"].ToString()!] = new
        {
            nombre = e["Nombre"].ToString(),
            grupo = e["GrupoMuscular"].ToString(),
            nivel = e["NivelDificultad"].ToString(),
            contra = e["ContraIndicacion"].ToString()
        };
    }
    var ejerciciosJson = JsonSerializer.Serialize(ejercicios);
    var detallesJson = JsonSerializer.Serialize(Model.Rutina.Detalles);
    var alertasJson = JsonSerializer.Serialize(Model.AlertasPorEjercicio);
    var conExpedienteJson = JsonSerializer.Serialize(Model.SociosConExpediente);
    var diasJson = JsonSerializer.Serialize(logicaRutina.DiasSemana);
}

<form method="post" id="formRutina">
    <section class="gestion">
        <div class="row g-4">

            <!-- Cabecera de la rutina -->
            <div class="col-lg-4">
                <div class="card-gestion h-100">
                    <h4 class="titulo-card text-center"><i class="bi bi-clipboard2-pulse"></i>&nbsp;Nueva rutina</h4>

                    <h6 class="subtitulo-seccion">Asignación</h6>
                    <div class="form-floating mb-3">
                        <select asp-for="Rutina.IdCliente" asp-items="Model.Socios" class="form-select" id="selSocio" required>
                            <option value="">Selecciona...</option>
                        </select>
                        <label asp-for="Rutina.IdCliente">Socio<span class="asterisco"> *</span></label>
                    </div>

                    <div class="form-floating mb-1">
                        @if (Model.EsEntrenador)
                        {
                            <input type="hidden" asp-for="Rutina.IdEmpleado" />
                            <select asp-for="Rutina.IdEmpleado" asp-items="Model.Entrenadores" class="form-select" disabled>
                                <option value="">Sin empleado ligado</option>
                            </select>
                        }
                        else
                        {
                            <select asp-for="Rutina.IdEmpleado" asp-items="Model.Entrenadores" class="form-select" required>
                                <option value="">Selecciona...</option>
                            </select>
                        }
                        <label asp-for="Rutina.IdEmpleado">Entrenador<span class="asterisco"> *</span></label>
                    </div>
                    <small class="ayuda">@(Model.EsEntrenador ? "Las rutinas que diseñas quedan a tu nombre." : "Solo aparecen empleados activos con puesto Entrenador.")</small>

                    <div class="form-floating mb-3">
                        <input asp-for="Rutina.Nombre" class="form-control" placeholder="Nombre de la rutina" maxlength="50" autocomplete="off" required />
                        <label asp-for="Rutina.Nombre">Nombre de la rutina<span class="asterisco"> *</span></label>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Rutina.Objetivo" asp-items="Model.Objetivos" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Rutina.Objetivo">Objetivo<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Rutina.FechaAsignacion" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" required />
                                <label asp-for="Rutina.FechaAsignacion">Fecha de asignación<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Expediente médico -->
                    <h6 class="subtitulo-seccion"><i class="bi bi-heart-pulse"></i> Expediente médico</h6>
                    <partial name="_ExpedienteMedico" model="Model.Expediente" />

                    <hr />
                    <div class="info">
                        Arma la semana del socio agregando ejercicios a cada día. Si un ejercicio está contraindicado
                        para lo que registra su expediente médico, verás una <b>alerta</b> y tendrás que confirmarla para guardar.
                    </div>
                </div>
            </div>
            <!-- Fin Cabecera -->

            <!-- Matriz semanal -->
            <div class="col-lg-8">
                <div class="card-gestion h-100 d-flex flex-column">
                    <h4 class="titulo-card"><i class="bi bi-calendar-week"></i>&nbsp;Asignación semanal</h4>

                    <!-- Agregar ejercicio -->
                    <div class="row g-2 align-items-start mb-2">
                        <div class="col-6 col-md-2">
                            <div class="form-floating">
                                <select class="form-select" id="nuevoDia">
                                    @foreach (var dia in logicaRutina.DiasSemana)
                                    {
                                        <option value="@dia">@dia</option>
                                    }
                                </select>
                                <label for="nuevoDia">Día</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="form-floating">
                                <select class="form-select" id="nuevoEjercicio">
                                    <option value="">Selecciona...</option>
                                    @* Los ejercicios vienen ordenados por grupo muscular (spEjercicio).
                                       Cada vez que cambia el grupo se cierra el optgroup anterior y se abre uno nuevo. *@
                                    @{ string grupoActual = ""; }
                                    @foreach (DataRow e in Model.Ejercicios)
                                    {
                                        string grupo = e["GrupoMuscular"].ToString()!;
                                        if (grupo != grupoActual)
                                        {
                                            if (grupoActual != "")
                                            {
                                                @:</optgroup>
                                            }
                                            @:<optgroup label="@grupo">
                                            grupoActual = grupo;
                                        }
                                        <option value="@e["IdEjercicio"]">@e["Nombre"] · @e["NivelDificultad"]</option>
                                    }
                                    @if (grupoActual != "")
                                    {
                                        @:</optgroup>
                                    }
                                </select>
                                <label for="nuevoEjercicio">Ejercicio</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="nuevoSeries" min="1" step="1" value="3" placeholder="Series" />
                                <label for="nuevoSeries">Series</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="nuevoRepeticiones" min="1" value="12" placeholder="Repeticiones" />
                                <label for="nuevoRepeticiones">Reps</label>
                            </div>
                        </div>
                        <div class="col-4 col-md-2">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="nuevoDescanso" min="0" value="60" placeholder="Descanso" />
                                <label for="nuevoDescanso">Descanso (s)</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <button type="button" class="btn btn-naranja btn-sm-pill" id="btnAgregar">
                            <i class="bi bi-plus-lg me-1"></i>Agregar al día
                        </button>
                        <span id="errorAgregar" class="text-validacion m-0"></span>
                        <span id="alertaPrevia" class="alerta-previa d-none"></span>
                    </div>

                    <!-- Matriz Lunes a Domingo -->
                    <div class="matriz-semanal" id="matriz"></div>

                    <!-- Alertas médicas -->
                    <div id="panelAlertas" class="panel-alertas d-none">
                        <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Alertas médicas</div>
                        <ul id="listaAlertas" class="mb-2"></ul>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="ConfirmarAlertas" />
                            <label class="form-check-label" asp-for="ConfirmarAlertas">
                                Revisé las alertas y confirmo que el socio puede realizar estos ejercicios.
                            </label>
                        </div>
                    </div>

                    <div id="detallesOcultos"></div>

                    <div class="d-flex justify-content-end gap-2 mt-auto pt-4">
                        <a class="btn btn-oscuro" asp-page="/Rutina">Cancelar</a>
                        <button type="submit" class="btn btn-naranja">
                            <i class="bi bi-floppy me-1"></i>Guardar rutina
                        </button>
                    </div>
                </div>
            </div>
            <!-- Fin Matriz semanal -->

        </div>
    </section>
</form>

@section Scripts {
    <script>
        // Datos que manda la página
        var ejercicios = @Html.Raw(ejerciciosJson);          // { "1": { nombre, grupo, nivel, contra }, ... }
        var dias = @Html.Raw(diasJson);                      // [ "Lunes", ..., "Domingo" ]
        var conExpediente = @Html.Raw(conExpedienteJson);    // Ids de los socios que tienen expediente
        var alertas = @Html.Raw(alertasJson);                // { "IdEjercicio": "texto de la alerta" }
        var detalles = @Html.Raw(detallesJson);              // Ejercicios agregados a la rutina

        // Convierte un texto para meterlo al HTML sin que se interprete como etiquetas
        function escapar(valor) {
            var span = document.createElement('span');
            span.textContent = valor;
            return span.innerHTML;
        }

        // Dibuja la matriz de Lunes a Domingo con los ejercicios de cada día
        function dibujar() {
            var html = '';

            for (var j = 0; j < dias.length; j++) {
                var dia = dias[j];
                var items = '';
                var cantidad = 0;

                for (var i = 0; i < detalles.length; i++) {
                    var d = detalles[i];
                    if (d.DiaSemana != dia)
                        continue;

                    cantidad++;
                    var e = ejercicios[d.IdEjercicio];
                    if (e == null)
                        e = { nombre: 'Ejercicio inactivo', grupo: '' };

                    var alerta = alertas[d.IdEjercicio];
                    var claseAlerta = '';
                    var iconoAlerta = '';
                    if (alerta) {
                        claseAlerta = 'con-alerta';
                        iconoAlerta = '<i class="bi bi-exclamation-triangle-fill"></i> ';
                    } else {
                        alerta = '';
                    }

                    items += '<div class="ejercicio-dia ' + claseAlerta + '" title="' + escapar(alerta) + '">'
                        + '<button type="button" class="quitar" data-i="' + i + '" aria-label="Quitar"><i class="bi bi-x"></i></button>'
                        + '<div class="nombre">' + iconoAlerta + escapar(e.nombre) + '</div>'
                        + '<div class="grupo">' + escapar(e.grupo) + '</div>'
                        + '<div class="metricas">' + d.Series + '×' + d.Repeticiones + ' · ' + d.TiempoDescanso + 's</div>'
                        + '</div>';
                }

                if (items == '')
                    items = '<div class="dia-vacio">Descanso</div>';

                html += '<div class="dia-col">'
                    + '<div class="dia-titulo">' + dia + '<span>' + cantidad + '</span></div>'
                    + '<div class="dia-items">' + items + '</div>'
                    + '</div>';
            }
            document.getElementById('matriz').innerHTML = html;

            // Alertas de los ejercicios que ya están en la rutina (sin repetir)
            var lista = [];
            for (var i = 0; i < detalles.length; i++) {
                var texto = alertas[detalles[i].IdEjercicio];
                if (texto && lista.indexOf(texto) == -1)
                    lista.push(texto);
            }

            var htmlAlertas = '';
            for (var i = 0; i < lista.length; i++) {
                htmlAlertas += '<li>' + escapar(lista[i]) + '</li>';
            }
            document.getElementById('listaAlertas').innerHTML = htmlAlertas;

            if (lista.length == 0)
                document.getElementById('panelAlertas').classList.add('d-none');
            else
                document.getElementById('panelAlertas').classList.remove('d-none');

            // Marca en el combo los ejercicios contraindicados con ⚠
            var opciones = document.getElementById('nuevoEjercicio').options;
            for (var i = 0; i < opciones.length; i++) {
                var op = opciones[i];
                if (op.value == '')
                    continue;

                var nombre = op.textContent.replace('⚠ ', '');
                if (alertas[op.value])
                    op.textContent = '⚠ ' + nombre;
                else
                    op.textContent = nombre;
            }

            mostrarAlertaPrevia();
        }

        // Muestra la alerta del ejercicio elegido antes de agregarlo
        function mostrarAlertaPrevia() {
            var aviso = document.getElementById('alertaPrevia');
            var alerta = alertas[document.getElementById('nuevoEjercicio').value];

            if (alerta) {
                aviso.textContent = '⚠ ' + alerta;
                aviso.classList.remove('d-none');
            } else {
                aviso.textContent = '';
                aviso.classList.add('d-none');
            }
        }

        // Muestra el expediente del socio (o el aviso de que no tiene)
        function mostrarExpediente(r) {
            var vacio = document.getElementById('expedienteVacio');
            var datos = document.getElementById('expedienteDatos');

            if (r.tieneExpediente) {
                document.getElementById('expTipoSangre').textContent = r.expediente.tipoSangre || '—';
                document.getElementById('expPadecimientos').textContent = r.expediente.padecimientos || '—';
                document.getElementById('expLesiones').textContent = r.expediente.lesiones || '—';
                document.getElementById('expAlergias').textContent = r.expediente.alergias || '—';
                document.getElementById('expCondicion').textContent = r.expediente.condicion || '—';
                vacio.classList.add('d-none');
                datos.classList.remove('d-none');
            } else {
                document.getElementById('expedienteVacioTexto').textContent = 'Este socio no tiene expediente médico. Es obligatorio para asignarle una rutina.';
                vacio.classList.remove('d-none');
                vacio.classList.add('sin-expediente');
                datos.classList.add('d-none');
            }
        }

        // Botón "Agregar al día": valida y agrega el ejercicio a la rutina
        document.getElementById('btnAgregar').addEventListener('click', function () {
            var d = {
                IdEjercicio: parseInt(document.getElementById('nuevoEjercicio').value),
                DiaSemana: document.getElementById('nuevoDia').value,
                Series: parseInt(document.getElementById('nuevoSeries').value),
                Repeticiones: parseInt(document.getElementById('nuevoRepeticiones').value),
                TiempoDescanso: parseInt(document.getElementById('nuevoDescanso').value)
            };

            var error = '';
            if (isNaN(d.IdEjercicio))
                error = 'Selecciona un ejercicio.';
            else if (isNaN(d.Series) || d.Series <= 0)
                error = 'Las series deben ser mayores a 0.';
            else if (isNaN(d.Repeticiones) || d.Repeticiones <= 0)
                error = 'Las repeticiones deben ser mayores a 0.';
            else if (isNaN(d.TiempoDescanso) || d.TiempoDescanso < 0)
                error = 'El descanso no puede ser negativo.';

            document.getElementById('errorAgregar').textContent = error;
            if (error != '')
                return;

            detalles.push(d);
            dibujar();
        });

        // Botón X de cada ejercicio: lo quita de la rutina
        document.getElementById('matriz').addEventListener('click', function (e) {
            var boton = e.target.closest('.quitar');
            if (boton == null)
                return;

            detalles.splice(parseInt(boton.getAttribute('data-i')), 1);
            dibujar();
        });

        document.getElementById('nuevoEjercicio').addEventListener('change', mostrarAlertaPrevia);

        // Al cambiar de socio se trae su expediente y se recalculan las alertas
        document.getElementById('selSocio').addEventListener('change', function () {
            var id = this.value;
            alertas = {};

            if (id == '') {
                document.getElementById('expedienteVacioTexto').textContent = 'Selecciona un socio para ver su expediente médico.';
                document.getElementById('expedienteVacio').classList.remove('d-none');
                document.getElementById('expedienteVacio').classList.remove('sin-expediente');
                document.getElementById('expedienteDatos').classList.add('d-none');
                dibujar();
                return;
            }

            fetch('?handler=Expediente&idCliente=' + id)
                .then(function (respuesta) { return respuesta.json(); })
                .then(function (r) {
                    alertas = r.alertas;
                    mostrarExpediente(r);
                    dibujar();
                });
        });

        // Antes de enviar, convierte los ejercicios en campos ocultos Rutina.Detalles[i].*
        document.getElementById('formRutina').addEventListener('submit', function (e) {
            if (detalles.length == 0) {
                e.preventDefault();
                document.getElementById('errorAgregar').textContent = 'Agrega al menos un ejercicio a la rutina.';
                return;
            }

            var campos = ['IdEjercicio', 'DiaSemana', 'Series', 'Repeticiones', 'TiempoDescanso'];
            var html = '';
            for (var i = 0; i < detalles.length; i++) {
                for (var c = 0; c < campos.length; c++) {
                    html += '<input type="hidden" name="Rutina.Detalles[' + i + '].' + campos[c] + '" value="' + escapar(detalles[i][campos[c]]) + '" />';
                }
            }
            document.getElementById('detallesOcultos').innerHTML = html;
        });

        // Si regresó del servidor con un socio sin expediente, muestra el aviso
        var socioElegido = document.getElementById('selSocio').value;
        if (socioElegido != '' && conExpediente.indexOf(parseInt(socioElegido)) == -1) {
            document.getElementById('expedienteVacioTexto').textContent = 'Este socio no tiene expediente médico. Es obligatorio para asignarle una rutina.';
            document.getElementById('expedienteVacio').classList.add('sin-expediente');
        }

        dibujar();
    </script>
}
