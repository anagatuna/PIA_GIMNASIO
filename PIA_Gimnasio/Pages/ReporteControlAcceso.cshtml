@page
@model PIA_Gimnasio.Pages.ReporteControlAccesoModel
@{
    ViewData["Title"] = "Reporte de control de acceso";
    ViewData["AnchoCompleto"] = true;
}

<section class="gestion">
    <div class="card-gestion">
        <h4 class="titulo-card"><i class="bi bi-file-earmark-bar-graph"></i>&nbsp;Reporte: <span class="resaltado">Control de acceso</span></h4>

        <form method="get">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="form-floating">
                        <input asp-for="Busqueda" class="form-control" placeholder="Folio o nombre" maxlength="50" />
                        <label asp-for="Busqueda">Socio (folio o nombre)</label>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="form-floating">
                        <select asp-for="IdSucursal" asp-items="Model.Sucursales" class="form-select"><option value="">Todas</option></select>
                        <label asp-for="IdSucursal">Sucursal</label>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="form-floating">
                        <input asp-for="Desde" type="date" class="form-control" />
                        <label asp-for="Desde">Desde</label>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="form-floating">
                        <input asp-for="Hasta" type="date" class="form-control" />
                        <label asp-for="Hasta">Hasta</label>
                    </div>
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-center gap-2">
                    <button type="submit" class="btn-circulo btn-naranja" title="Buscar"><i class="bi bi-search"></i></button>
                    <a class="btn-circulo btn-oscuro" asp-page="/ReporteControlAcceso" title="Limpiar"><i class="bi bi-stars"></i></a>
                    <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar"><i class="bi bi-file-earmark-spreadsheet"></i></button>
                </div>
            </div>
        </form>

        <div class="tarjetas-resumen mb-3">
            <div class="tarjeta"><span>Visitas</span><b>@Model.TotalRegistros</b></div>
            <div class="tarjeta"><span>Socios distintos</span><b>@Model.SociosDistintos</b></div>
            <div class="tarjeta"><span>Permanencia promedio</span><b>@Math.Round(Model.PromedioMinutos) <small>min</small></b></div>
            <div class="tarjeta verde"><span>Sin salida registrada</span><b>@Model.Dentro</b></div>
        </div>

        @if (Model.Filas.Count > 0)
        {
            <div class="table-responsive tabla-gestion">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Folio</th><th>Socio</th><th>Sucursal</th><th>Entrada</th><th>Salida</th><th class="text-end">Permanencia</th></tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow f in Model.Filas)
                        {
                            <tr>
                                <td class="fw-bold">@f["Folio"]</td>
                                <td>@f["Socio"]</td>
                                <td>@f["Sucursal"]</td>
                                <td>@Convert.ToDateTime(f["FechaEntrada"]).ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (f["FechaSalida"] == DBNull.Value)
                                    {
                                        <span class="etiqueta etiqueta-rol">Sin salida</span>
                                    }
                                    else
                                    {
                                        @Convert.ToDateTime(f["FechaSalida"]).ToString("dd/MM/yyyy HH:mm")
                                    }
                                </td>
                                <td class="text-end fw-semibold">@(f["Minutos"] == DBNull.Value ? "—" : f["Minutos"] + " min")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Paginacion" model="Model" />
        }
        else
        {
            <div class="sin-registros"><i class="bi bi-inbox"></i>No se encontraron registros con los parámetros solicitados.</div>
        }
    </div>
</section>
