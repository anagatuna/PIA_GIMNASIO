@page
@model PIA_Gimnasio.Pages.ControlAccesoModel
@{
    ViewData["Title"] = "Control de acceso";
    ViewData["AnchoCompleto"] = true;

    // Hora en formato 08:30 (vacío si no hay)
    string Hora(object valor)
    {
        if (valor == DBNull.Value)
            return "";
        return ((TimeSpan)valor).ToString(@"hh\:mm");
    }

    // Colores del semáforo según el resultado del último folio
    string estado = "espera";
    string icono = "bi-hourglass";
    string titulo = "Esperando folio";
    string aviso = "Captura o escanea el folio del socio.";

    if (Model.Resultado == "Permitido")
    {
        estado = "verde";
        icono = "bi-check-lg";
        titulo = "ACCESO PERMITIDO";
    }
    else if (Model.Resultado == "Salida")
    {
        estado = "salida";
        icono = "bi-box-arrow-right";
        titulo = "SALIDA REGISTRADA";
    }
    else if (Model.Resultado != "")
    {
        estado = "rojo";
        icono = "bi-x-lg";
        titulo = "ACCESO DENEGADO";
    }

    if (Model.Aviso != "")
        aviso = Model.Aviso;
}

<section class="gestion control-acceso">

    @if (Model.EsAdministrador)
    {
        <form method="get" class="d-flex align-items-center gap-2 mb-3">
            <div class="form-floating flex-grow-1" style="max-width: 360px">
                <select asp-for="IdSucursal" asp-items="Model.Sucursales" class="form-select" onchange="this.form.submit()"></select>
                <label asp-for="IdSucursal">Sucursal</label>
            </div>
        </form>
    }

    @if (Model.Aforo != null)
    {
        <div class="row g-4">

            <!-- Captura rápida + semáforo -->
            <div class="col-lg-5">
                <div class="card-gestion h-100">
                    <h4 class="titulo-card text-center"><i class="bi bi-door-open"></i>&nbsp;@Model.Aforo["Nombre"]</h4>
                    <p class="text-center text-secondary small mb-3">
                        Horario @Hora(Model.Aforo["HoraApertura"]) - @Hora(Model.Aforo["HoraCierre"])
                        @if (DateTime.Now.TimeOfDay < (TimeSpan)Model.Aforo["HoraApertura"] || DateTime.Now.TimeOfDay > (TimeSpan)Model.Aforo["HoraCierre"])
                        {
                            <br /><span class="text-danger fw-semibold"><i class="bi bi-lock"></i> Cerrada en este momento: no se registran entradas ni salidas.</span>
                        }
                    </p>

                    <form method="post" autocomplete="off">
                        <input type="hidden" asp-for="IdSucursal" />
                        <div class="form-floating mb-3">
                            <input asp-for="Folio" id="folio" class="form-control campo-folio" placeholder="Folio" inputmode="numeric" maxlength="8" autofocus />
                            <label for="folio"><i class="bi bi-upc-scan"></i> Folio del socio</label>
                        </div>
                        <div class="d-flex gap-2">
                            @* El primer botón es el que se usa al presionar Enter *@
                            <button type="submit" class="btn btn-verde flex-fill py-3" asp-page-handler="Entrada">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Registrar entrada <small class="d-block opacity-75">Enter</small>
                            </button>
                            <button type="submit" class="btn btn-oscuro flex-fill py-3" asp-page-handler="Salida">
                                <i class="bi bi-box-arrow-right me-1"></i>Registrar salida
                            </button>
                        </div>
                    </form>

                    <!-- Semáforo -->
                    <div class="semaforo @estado mt-3">
                        <div class="luz"><i class="bi @icono"></i></div>
                        <div class="semaforo-texto">
                            <div class="semaforo-titulo">@titulo</div>
                            <div>@aviso</div>
                            @if (Model.DatosSocio != null && Model.DatosSocio["Socio"] != DBNull.Value)
                            {
                                <div class="semaforo-socio">
                                    <b>@Model.DatosSocio["Socio"]</b> · Folio @Model.FolioCapturado
                                    @if (Model.DatosSocio["Membresia"] != DBNull.Value)
                                    {
                                        <br />
                                        <span>Membresía @Model.DatosSocio["Membresia"] · vence @Convert.ToDateTime(Model.DatosSocio["FechaVencimiento"]).ToString("dd/MM/yyyy")</span>
                                    }
                                    @if (Model.DatosSocio["Minutos"] != DBNull.Value)
                                    {
                                        <br />
                                        <span>Permanencia: <b>@Model.DatosSocio["Minutos"] min</b></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aforo + movimientos -->
            <div class="col-lg-7">
                <div class="card-gestion h-100">
                    <div class="aforo-tiempo-real mb-3">
                        <div>
                            <div class="text-secondary small text-uppercase fw-semibold">Aforo actual</div>
                            <div class="aforo-cifra">@Model.Aforo["Ocupacion"]<small> / @Model.Aforo["AforoMaximo"]</small></div>
                        </div>
                        <a class="btn btn-oscuro btn-sm-pill ms-auto" asp-page="/ControlAcceso" asp-route-idSucursal="@Model.IdSucursal" title="Actualizar">
                            <i class="bi bi-arrow-clockwise"></i> Actualizar
                        </a>
                    </div>

                    <h5 class="titulo-card"><i class="bi bi-clock-history"></i>&nbsp;Movimientos de hoy</h5>
                    <div class="table-responsive tabla-gestion tabla-movimientos">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Socio</th>
                                    <th>Entrada</th>
                                    <th>Salida</th>
                                    <th class="text-end">Permanencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Movimientos.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-secondary">Sin movimientos hoy.</td></tr>
                                }
                                @foreach (DataRow m in Model.Movimientos)
                                {
                                    bool dentro = m["FechaSalida"] == DBNull.Value;

                                    <tr class="@(dentro ? "dentro" : "")">
                                        <td class="fw-bold">@m["Folio"]</td>
                                        <td>@m["Socio"]</td>
                                        <td>@Convert.ToDateTime(m["FechaEntrada"]).ToString("HH:mm")</td>
                                        <td>
                                            @if (dentro)
                                            {
                                                <span class="etiqueta etiqueta-activo">Dentro</span>
                                            }
                                            else
                                            {
                                                @Convert.ToDateTime(m["FechaSalida"]).ToString("HH:mm")
                                            }
                                        </td>
                                        <td class="text-end">@m["Minutos"] min</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    }
</section>
