@page
@model PIA_Gimnasio.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null; // El login va sin el menú del sistema
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chispi Fit</title>
    <link rel="icon" type="image/png" href="~/img/logo-icono.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <img src="~/img/fondo.jpeg" alt="" class="fondo" aria-hidden="true" />
    <div class="fondo-overlay"></div>

    <main class="contenedor">
        <!-- Texto de bienvenida -->
        <section class="hero">
            <img src="~/img/logo-oscuro.png" alt="Chispi Fit" class="hero-logo" />
            <h2>Tu gimnasio,<br /><span>bajo control.</span></h2>
            <p>Administra socios, membresías y sucursales desde un solo lugar.</p>
        </section>

        <!-- Login -->
        <div class="login-col">
            <div class="login-card">
                <h1 class="titulo">Bienvenido</h1>
                <p class="subtitulo">Inicia sesión para continuar</p>

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alerta-error" role="alert">@Model.MensajeError</div>
                }

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Input.Cuenta" class="form-label">Cuenta</label>
                        <input asp-for="Input.Cuenta" class="form-control" placeholder="Usuario" maxlength="50" autocomplete="username" autofocus required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Contrasenia" class="form-label">Contraseña</label>
                        <div class="campo-pass">
                            <input asp-for="Input.Contrasenia" type="password" class="form-control" placeholder="Contraseña" maxlength="50" autocomplete="current-password" required />
                            <button type="button" class="btn-ver" id="btnVer">Mostrar</button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-entrar w-100">Entrar</button>
                </form>
            </div>

            <p class="pie">&copy; @DateTime.Now.Year Chispi Fit</p>
        </div>
    </main>

    <script>
            // Mostrar / ocultar contraseña
            (function() {
                const btn = document.getElementById('btnVer');
                const input = document.getElementById('Input_Contrasenia');
                if (!btn || !input) return;
                btn.addEventListener('click', function() {
                    const oculto = input.type === 'password';
                    input.type = oculto ? 'text' : 'password';
                    btn.textContent = oculto ? 'Ocultar' : 'Mostrar';
                });
            })();
    </script>
</body>
</html>
