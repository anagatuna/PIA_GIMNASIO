@page
@model PIA_Gimnasio.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null; // El login va sin el menú del sistema
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PIA Gimnasio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-sm" style="width: 100%; max-width: 380px;">
            <div class="card-body p-4">
                <h1 class="h4 text-center mb-1">PIA Gimnasio</h1>
                <p class="text-center text-muted mb-4">Inicia sesión para continuar</p>

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alert alert-danger py-2">@Model.MensajeError</div>
                }

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Input.Cuenta" class="form-label">Cuenta</label>
                        <input asp-for="Input.Cuenta" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Input.Cuenta" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Contrasenia" class="form-label">Contraseña</label>
                        <input asp-for="Input.Contrasenia" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Contrasenia" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
