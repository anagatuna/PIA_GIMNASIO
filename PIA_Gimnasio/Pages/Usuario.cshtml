@page
@model PIA_Gimnasio.Pages.UsuarioModel
@{
    ViewData["Title"] = "Gestión de usuarios";
    ViewData["AnchoCompleto"] = true;
    ViewData["EliminarTitulo"] = "¿Eliminar usuario?";          // El Layout pinta la confirmación
    ViewData["EliminarDescripcion"] = "ya no podrá iniciar sesión y su empleado quedará libre para otra cuenta.";
    bool esEdicion = Model.Usuario.IdUsuario > 0;
}

<!-- Contenedor Principal -->
<section class="gestion">
    <div class="row g-4">

        <!-- Gestión de información -->
        <div class="col-lg-4">
            <div class="card-gestion h-100">
                <h4 class="titulo-card text-center">
                    <i class="bi bi-person-gear"></i>&nbsp;@(esEdicion ? "Editar usuario" : "Nuevo usuario")
                </h4>

                <form method="post" asp-page-handler="Guardar" asp-all-route-data="Model.RutaFiltros()">
                    <input type="hidden" asp-for="Usuario.IdUsuario" />

                    <!-- Empleado (relación 1:1) -->
                    <h6 class="subtitulo-seccion">Empleado</h6>
                    <div class="form-floating mb-1">
                        @if (esEdicion)
                        {
                            <select asp-for="Usuario.IdEmpleado" asp-items="Model.Empleados" class="form-select" disabled>
                                <option value="">Sin empleado ligado</option>
                            </select>
                        }
                        else
                        {
                            <select asp-for="Usuario.IdEmpleado" asp-items="Model.Empleados" class="form-select" required>
                                <option value="">Selecciona...</option>
                            </select>
                        }
                        <label asp-for="Usuario.IdEmpleado">Empleado<span class="asterisco @(esEdicion ? "d-none" : "")"> *</span></label>
                    </div>
                    <small class="ayuda">
                        @(esEdicion ? "El empleado de una cuenta no se puede cambiar." : "Solo aparecen empleados activos que todavía no tienen cuenta.")
                    </small>

                    <hr />

                    <!-- Datos de acceso -->
                    <h6 class="subtitulo-seccion">Datos de acceso</h6>
                    <div class="form-floating mb-3">
                        <input asp-for="Usuario.Cuenta" class="form-control" placeholder="Cuenta" maxlength="50" autocomplete="off" required pattern="\S+" title="La cuenta no puede llevar espacios." />
                        <label asp-for="Usuario.Cuenta">Cuenta<span class="asterisco"> *</span></label>
                    </div>

                    <div class="form-floating mb-1">
                        <input asp-for="Usuario.Contrasenia" type="password" class="form-control" placeholder="Contraseña" minlength="6" maxlength="50" autocomplete="new-password" required="@(!esEdicion)" />
                        <label asp-for="Usuario.Contrasenia">Contraseña<span class="asterisco @(esEdicion ? "d-none" : "")"> *</span></label>
                    </div>
                    @if (esEdicion)
                    {
                        <small class="ayuda">Déjala vacía para conservar la contraseña actual.</small>
                    }

                    <hr />

                    <!-- Permisos -->
                    <h6 class="subtitulo-seccion">Permisos</h6>
                    <div class="row">
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Usuario.IdRol" asp-items="Model.Roles" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Usuario.IdRol">Rol<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Usuario.IdEstatus" asp-items="Model.Estatus" class="form-select" required>
                                    <option value="">Selecciona...</option>
                                </select>
                                <label asp-for="Usuario.IdEstatus">Estatus<span class="asterisco"> *</span></label>
                            </div>
                        </div>
                    </div>

                    <div class="nota">
                        <strong>Nota:</strong> Los campos obligatorios están marcados con
                        <abbr title="obligatorio" class="asterisco">*</abbr>.
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="submit" class="btn btn-naranja">
                            <i class="bi bi-floppy me-1"></i>@(esEdicion ? "Actualizar" : "Guardar")
                        </button>
                        <a class="btn btn-oscuro" asp-page="/Usuario" asp-all-route-data="Model.RutaFiltros()">Cancelar</a>
                    </div>
                </form>

                <!-- Área de información -->
                <hr />
                <h5 class="titulo-card text-center"><i class="bi bi-info-circle-fill"></i>&nbsp;Información</h5>
                <div class="info">
                    Este módulo permite las altas, bajas y modificaciones de los usuarios que tienen acceso al sistema.
                    Cada cuenta pertenece a <b>un solo empleado</b> y cada empleado puede tener solo una cuenta.
                    El rol determina las opciones que verá cada usuario y solo los usuarios con estatus
                    <b>Activo</b> pueden iniciar sesión.
                </div>
                <!-- Fin Área de información -->
            </div>
        </div>
        <!-- Fin Gestión de información -->

        <!-- Consulta de registros -->
        <div class="col-lg-8">
            <div class="card-gestion h-100">
                <h4 class="titulo-card"><i class="bi bi-grid-3x3-gap"></i>&nbsp;Consulta registros: <span class="resaltado">Usuarios</span></h4>

                <!-- Filtros o Búsqueda -->
                <p class="mb-2"><strong><i class="bi bi-funnel"></i>&nbsp;Área de búsqueda</strong></p>
                <form method="get" id="formBusqueda">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <input asp-for="BusquedaCuenta" class="form-control" placeholder="Búsqueda por cuenta" maxlength="50" />
                                <label asp-for="BusquedaCuenta">Búsqueda por cuenta</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdRol" asp-items="Model.Roles" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdRol">Rol</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-floating">
                                <select asp-for="BusquedaIdEstatus" asp-items="Model.Estatus" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                                <label asp-for="BusquedaIdEstatus">Estatus</label>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn-circulo btn-naranja" title="Buscar">
                                    <i class="bi bi-search"></i>
                                </button>
                                <a class="btn-circulo btn-oscuro" asp-page="/Usuario" title="Limpiar">
                                    <i class="bi bi-stars"></i>
                                </a>
                                <button type="submit" class="btn-circulo btn-verde" title="Exportar Excel" name="handler" value="Exportar">
                                    <i class="bi bi-file-earmark-spreadsheet"></i>
                                </button>
                            </div>
                        </div>
                        <!-- Fin Botones -->
                    </div>
                </form>
                <!-- Fin Filtros -->

                <!-- Tabla para mostrar la información -->
                @if (Model.Usuarios.Count > 0)
                {
                    <div class="table-responsive tabla-gestion">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="col-accion">Editar</th>
                                    <th class="col-accion">Eliminar</th>
                                    <th>Empleado</th>
                                    <th>Cuenta</th>
                                    <th>Rol</th>
                                    <th>Estatus</th>
                                    <th>Registro</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow fila in Model.Usuarios)
                                {
                                    var id = fila["IdUsuario"];
                                    var empleado = fila["Empleado"]?.ToString();
                                    bool activo = Convert.ToInt32(fila["IdEstatus"]) == 1;
                                    var rutaEditar = Model.RutaFiltros();
                                    rutaEditar["id"] = id.ToString()!;

                                    <tr class="@(Model.Usuario.IdUsuario.ToString() == id.ToString() ? "fila-seleccionada" : "")">
                                        <td class="col-accion">
                                            <a class="btn-circulo btn-sm-circulo btn-amarillo" title="Editar"
                                               asp-page="/Usuario" asp-page-handler="Editar" asp-all-route-data="rutaEditar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                        <td class="col-accion">
                                            <button type="button" class="btn-circulo btn-sm-circulo btn-rojo" title="Eliminar"
                                                    data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                    data-id="@id" data-nombre="@fila["Cuenta"]">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                        <td class="fw-semibold">@(string.IsNullOrWhiteSpace(empleado) ? "Sin empleado ligado" : empleado)</td>
                                        <td>@fila["Cuenta"]</td>
                                        <td><span class="etiqueta etiqueta-rol">@fila["Rol"]</span></td>
                                        <td><span class="etiqueta @(activo ? "etiqueta-activo" : "etiqueta-inactivo")">@fila["Estatus"]</span></td>
                                        <td class="text-nowrap">@Convert.ToDateTime(fila["FechaRegistro"]).ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Paginacion" model="Model" />
                }
                else
                {
                    <div class="sin-registros">
                        <i class="bi bi-inbox"></i>
                        No se encontraron registros con los parámetros solicitados.
                    </div>
                }
                <!-- Fin Tabla para mostrar la información -->
            </div>
        </div>
        <!-- Fin Consulta de registros -->

    </div>
</section>
<!-- Fin Contenedor Principal -->
