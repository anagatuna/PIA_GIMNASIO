@* Ventana de aviso con el mensaje de la página (mismo diseño que la confirmación de eliminar).
   La pinta el Layout cuando la página trae Mensaje y TipoMensaje (success, warning o danger). *@
@model PIA_Gimnasio.Pages.PaginaProtegida
@{
    string icono = "bi-info-circle-fill";
    string titulo = "Aviso";

    if (Model.TipoMensaje == "success")
    {
        icono = "bi-check-circle-fill";
        titulo = "¡Listo!";
    }
    else if (Model.TipoMensaje == "warning")
    {
        icono = "bi-exclamation-triangle-fill";
        titulo = "Revisa la información";
    }
    else if (Model.TipoMensaje == "danger")
    {
        icono = "bi-x-circle-fill";
        titulo = "Ocurrió un error";
    }
}

<div class="modal fade" id="modalMensaje" tabindex="-1" aria-labelledby="modalMensajeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-gestion">
            <div class="modal-body text-center p-4">
                <div class="icono-alerta aviso-@Model.TipoMensaje"><i class="bi @icono"></i></div>
                <h5 id="modalMensajeLabel" class="fw-bold">@titulo</h5>
                <p class="text-secondary mb-0">@Model.Mensaje</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                <button type="button" class="btn btn-naranja" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>
<script>
    // Abre la ventana en cuanto carga la página
    var ventanaMensaje = document.getElementById('modalMensaje');
    new bootstrap.Modal(ventanaMensaje).show();

    @if (Model.RegresarA != "")
    {
        <text>
        // Al cerrar el aviso regresa a la pestaña de origen
        ventanaMensaje.addEventListener('hidden.bs.modal', function () {
            window.location.href = '@Url.Page(Model.RegresarA)';
        });
        </text>
    }
</script>
