@{
    // Datos del usuario que inició sesión (se guardan en Login.cshtml.cs)
    bool conSesion = Context.Session.GetInt32("IdUsuario") != null;
    string nombre = Context.Session.GetString("Nombre") ?? "";
    string rol = Context.Session.GetString("Rol") ?? "";
    string inicial = nombre == "" ? "U" : nombre.Substring(0, 1).ToUpper();

    bool admin = rol == "ADMINISTRADOR";
    bool recepcion = rol == "RECEPCIONISTA";
    bool entrenador = rol == "ENTRENADOR";

    // Página actual, para marcar la opción activa del menú
    string paginaActual = Convert.ToString(ViewContext.RouteData.Values["page"]) ?? "";

    // Las pantallas de gestión usan todo el ancho (ViewData["AnchoCompleto"] = true)
    string contenedor = "container";
    if (Convert.ToBoolean(ViewData["AnchoCompleto"]))
        contenedor = "container-fluid px-3 px-lg-4";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chispi Fit</title>
    <link rel="icon" type="image/png" href="~/img/logo-icono.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar mb-4">
        <div class="@contenedor d-flex align-items-center justify-content-between">
            <a class="marca" asp-page="/Inicio">
                <img src="~/img/logo-claro.png" alt="Chispi Fit" />
            </a>

            @if (conSesion)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="usuario-chip d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i>@nombre
                    </span>
                    <button class="btn-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuOpciones" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            }
        </div>
    </header>

    @if (conSesion)
    {
        <!-- Menú de opciones (cada rol ve solo sus pantallas) -->
        <div class="offcanvas offcanvas-end menu-lateral" tabindex="-1" id="menuOpciones">
            <div class="offcanvas-header">
                <img src="~/img/logo-oscuro.png" alt="Chispi Fit" class="menu-logo" />
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>

            <div class="offcanvas-body">
                <div class="menu-usuario">
                    <div class="avatar">@inicial</div>
                    <div>
                        @nombre
                        <small>@rol</small>
                    </div>
                </div>

                <a class="menu-link @(paginaActual == "/Inicio" ? "active" : "")" asp-page="/Inicio"><i class="bi bi-house"></i> Inicio</a>

                <!-- Socios -->
                <div class="menu-seccion">Socios</div>
                @if (admin || recepcion)
                {
                    <a class="menu-link @(paginaActual == "/Socio" ? "active" : "")" asp-page="/Socio"><i class="bi bi-people"></i> Socios</a>
                }
                <a class="menu-link @(paginaActual == "/ExpedienteMedico" ? "active" : "")" asp-page="/ExpedienteMedico"><i class="bi bi-heart-pulse"></i> Expediente médico</a>
                @if (admin || recepcion)
                {
                    <a class="menu-link @(paginaActual == "/Suscripcion" ? "active" : "")" asp-page="/Suscripcion"><i class="bi bi-credit-card-2-front"></i> Suscripciones</a>
                }

                <!-- Operación diaria -->
                <div class="menu-seccion">Operación</div>
                @if (admin || recepcion)
                {
                    <a class="menu-link @(paginaActual == "/ControlAcceso" ? "active" : "")" asp-page="/ControlAcceso"><i class="bi bi-door-open"></i> Control de acceso</a>
                }
                @if (admin)
                {
                    <a class="menu-link @(paginaActual == "/Clase" ? "active" : "")" asp-page="/Clase"><i class="bi bi-calendar3"></i> Clases grupales</a>
                }
                @if (admin || recepcion)
                {
                    <a class="menu-link @(paginaActual == "/Reserva" ? "active" : "")" asp-page="/Reserva"><i class="bi bi-bookmark-check"></i> Reservas</a>
                }
                @if (admin || entrenador)
                {
                    <a class="menu-link @(paginaActual == "/PaseLista" ? "active" : "")" asp-page="/PaseLista"><i class="bi bi-list-check"></i> Pase de lista</a>
                    <a class="menu-link @(paginaActual.StartsWith("/Rutina") ? "active" : "")" asp-page="/Rutina"><i class="bi bi-clipboard2-pulse"></i> Rutinas</a>
                }

                <!-- Administración (solo Administrador) -->
                @if (admin)
                {
                    <div class="menu-seccion">Administración</div>
                    <a class="menu-link @(paginaActual == "/Usuario" ? "active" : "")" asp-page="/Usuario"><i class="bi bi-shield-lock"></i> Usuarios</a>
                    <a class="menu-link @(paginaActual == "/Sucursal" ? "active" : "")" asp-page="/Sucursal"><i class="bi bi-building"></i> Sucursales</a>
                    <a class="menu-link @(paginaActual == "/Empleado" ? "active" : "")" asp-page="/Empleado"><i class="bi bi-person-workspace"></i> Empleados</a>
                }

                <!-- Reportes (el entrenador no tiene reportes) -->
                @if (admin || recepcion)
                {
                    <div class="menu-seccion">Reportes</div>
                }
                @if (admin)
                {
                    <a class="menu-link @(paginaActual == "/ReporteEmpleados" ? "active" : "")" asp-page="/ReporteEmpleados"><i class="bi bi-file-earmark-person"></i> Empleados por sucursal</a>
                }
                @if (admin || recepcion)
                {
                    <a class="menu-link @(paginaActual == "/ReporteSocios" ? "active" : "")" asp-page="/ReporteSocios"><i class="bi bi-file-earmark-text"></i> Socios y membresías</a>
                    <a class="menu-link @(paginaActual == "/ReporteControlAcceso" ? "active" : "")" asp-page="/ReporteControlAcceso"><i class="bi bi-file-earmark-bar-graph"></i> Control de acceso</a>
                }
                @if (admin)
                {
                    <a class="menu-link @(paginaActual == "/ReporteClases" ? "active" : "")" asp-page="/ReporteClases"><i class="bi bi-file-earmark-check"></i> Clases y asistencia</a>
                    <a class="menu-link @(paginaActual == "/ReporteRutinas" ? "active" : "")" asp-page="/ReporteRutinas"><i class="bi bi-file-earmark-medical"></i> Rutinas asignadas</a>
                }

                <!-- Cuenta -->
                <div class="menu-seccion">Mi cuenta</div>
                <a class="menu-link @(paginaActual == "/Perfil" ? "active" : "")" asp-page="/Perfil"><i class="bi bi-person-badge"></i> Mi perfil</a>

                <form method="post" asp-page="/Login" asp-page-handler="Salir" class="mt-4">
                    <button type="submit" class="btn-cerrar-sesion">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="@contenedor">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="@contenedor">
            &copy; @DateTime.Now.Year - PIA Gimnasio - <a asp-page="/Privacidad">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Ventana de aviso: se abre sola si la página trae Mensaje -->
    @{
        PIA_Gimnasio.Pages.PaginaProtegida? pagina = Model as PIA_Gimnasio.Pages.PaginaProtegida;
    }
    @if (pagina != null && pagina.Mensaje != "")
    {
        <partial name="_Mensaje" model="pagina" />
    }

    <!-- Ventana para confirmar eliminar (solo en las páginas que ponen ViewData["EliminarTitulo"]) -->
    @if (ViewData["EliminarTitulo"] != null)
    {
        <partial name="_ModalEliminar" />
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
