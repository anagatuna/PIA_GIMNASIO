@using PIA_Gimnasio.Seguridad
@{
    // Página actual para marcar el link activo en el menú
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Activo(string ruta) => paginaActual.StartsWith(ruta, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Un módulo está activo si la página actual le pertenece (ej. /RutinaNueva pertenece a /Rutina)
    bool ModuloActivo(Modulo m) => Modulos.ModuloDe(paginaActual) == m;

    // Las pantallas de gestión usan todo el ancho (ViewData["AnchoCompleto"] = true)
    var contenedor = ViewData["AnchoCompleto"] is true ? "container-fluid px-3 px-lg-4" : "container";

    // Confirmación para eliminar: la página pone ViewData["EliminarTitulo"] y ViewData["EliminarDescripcion"].
    // El formulario regresa a la misma página y búsqueda, con handler=Eliminar.
    string? accionEliminar = null;
    if (ViewData["EliminarTitulo"] != null)
    {
        var parametros = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Context.Request.QueryString.Value)
            .Where(p => p.Key != "handler" && p.Key != "id")
            .ToDictionary(p => p.Key, p => (string?)p.Value.ToString());
        parametros["handler"] = "Eliminar";
        accionEliminar = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, parametros);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chispi Fit</title>
    <link rel="icon" type="image/png" href="~/img/logo-icono.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PIA_Gimnasio.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar mb-4">
        <div class="@contenedor d-flex align-items-center justify-content-between">
            <a class="marca" asp-area="" asp-page="/Inicio">
                <img src="~/img/logo-claro.png" alt="Chispi Fit" />
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="usuario-chip d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i>@User.FindFirst("NombreCompleto")?.Value
                    </span>
                    <button class="btn-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuOpciones" aria-controls="menuOpciones" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            }
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var nombre = User.FindFirst("NombreCompleto")?.Value ?? "Usuario";
        var inicial = string.IsNullOrEmpty(nombre) ? "U" : nombre.Substring(0, 1).ToUpper();

        <!-- ---------- Menú de opciones ---------- -->
        <div class="offcanvas offcanvas-end menu-lateral" tabindex="-1" id="menuOpciones" aria-labelledby="menuOpcionesLabel">
            <div class="offcanvas-header">
                <img src="~/img/logo-oscuro.png" alt="Chispi Fit" class="menu-logo" id="menuOpcionesLabel" />
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>

            <div class="offcanvas-body">
                <div class="menu-usuario">
                    <div class="avatar">@inicial</div>
                    <div>
                        @nombre
                        <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </div>
                </div>

                <a class="menu-link @(paginaActual == "/Inicio" ? "active" : "")" asp-page="/Inicio">
                    <i class="bi bi-house"></i> Inicio
                </a>

                <!-- Módulos permitidos para el rol (Seguridad/Modulos.cs) -->
                @foreach (var seccion in Modulos.PermitidosPara(User).GroupBy(m => m.Seccion))
                {
                    var abierto = seccion.Any(ModuloActivo);
                    var idGrupo = "grupo" + seccion.Key.Replace(" ", "").Replace("ó", "o").Replace("á", "a");
                    bool desplegable = seccion.Count() > 3;

                    @if (desplegable)
                    {
                        <button class="menu-seccion boton-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#@idGrupo"
                                aria-expanded="@(abierto ? "true" : "false")" aria-controls="@idGrupo">
                            @seccion.Key <span class="cantidad">@seccion.Count()</span><i class="bi bi-chevron-down flecha"></i>
                        </button>
                        @:<div class="collapse @(abierto ? "show" : "")" id="@idGrupo"><div class="submenu">
                    }
                    else
                    {
                        <div class="menu-seccion">@seccion.Key</div>
                    }
                    @foreach (var m in seccion)
                    {
                        // Si la pantalla todavía no existe en el proyecto, se muestra deshabilitada
                        var url = Url.Page(m.Pagina);
                        if (url != null)
                        {
                            <a class="menu-link @(ModuloActivo(m) ? "active" : "")" href="@url">
                                <i class="bi @m.Icono"></i> @m.Titulo
                            </a>
                        }
                        else
                        {
                            <span class="menu-link pendiente" title="Pantalla en desarrollo">
                                <i class="bi @m.Icono"></i> @m.Titulo
                            </span>
                        }
                    }
                    @if (desplegable)
                    {
                        @:</div></div>
                    }
                }

                <!-- Cuenta -->
                <div class="menu-seccion">Mi cuenta</div>
                <a class="menu-link @Activo("/Perfil")" asp-page="/Perfil">
                    <i class="bi bi-person-badge"></i> Mi perfil
                </a>

                <form method="post" asp-page="/Login" asp-page-handler="Logout" class="mt-4">
                    <button type="submit" class="btn-cerrar-sesion">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="@contenedor">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Mensaje del SP (la página lo pasa con [ViewData] Mensaje / TipoMensaje) -->
    <partial name="_Mensaje" model='((string?)ViewData["Mensaje"], (string?)ViewData["TipoMensaje"])' />

    <!-- Confirmación para eliminar (solo en las páginas que la piden) -->
    @if (accionEliminar != null)
    {
        <partial name="_ModalEliminar" model='((string)ViewData["EliminarTitulo"]!, (string?)ViewData["EliminarDescripcion"] ?? "", accionEliminar)' />
    }

    <footer class="border-top footer text-muted">
        <div class="@contenedor">
            &copy; @DateTime.Now.Year - PIA Gimnasio - <a asp-area="" asp-page="/Privacidad">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
